---
interface Props {
  imageDir: string;
  gridPhotos: string[];
  sliderPhotos: string[];
  portrait?: boolean;
}

const { imageDir, gridPhotos, sliderPhotos, portrait = false } = Astro.props;

const hasContent = gridPhotos.length > 0 || sliderPhotos.length > 0;
const basePath = `/images/activities/${imageDir}`;
const sliderAspect = portrait ? 'aspect-[3/4]' : 'aspect-[4/3]';
---

{hasContent && (
  <div class="gallery-wrapper">
    {gridPhotos.length > 0 && (
      <div class="grid grid-cols-2 gap-3">
        {gridPhotos.map((photo, i) => (
          <div class="aspect-square rounded-xl overflow-hidden bg-surface-container">
            <img
              alt={`写真${i + 1}`}
              class="w-full h-full object-cover"
              src={`${basePath}/${photo}`}
            />
          </div>
        ))}
      </div>
    )}

    {sliderPhotos.length > 0 && (
      <div class="relative mt-6">
        <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-6 px-6 gallery-slider">
          {sliderPhotos.map((photo, i) => (
            <div class:list={['snap-center shrink-0 w-[85%] rounded-xl overflow-hidden bg-surface-container', sliderAspect]}>
              <img
                alt={`写真${gridPhotos.length + i + 1}`}
                class="w-full h-full object-cover"
                src={`${basePath}/${photo}`}
              />
            </div>
          ))}
        </div>
        <div class="flex items-center justify-center gap-3 mt-2 gallery-controls">
          <button class="gallery-prev w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:bg-surface-container-highest active:scale-90 transition-all">
            <span class="material-symbols-outlined text-lg">chevron_left</span>
          </button>
          <div class="flex gap-2 gallery-dots">
            {sliderPhotos.map((_, i) => (
              <button
                class:list={[
                  'w-3 h-3 rounded-full transition-colors',
                  i === 0 ? 'bg-primary' : 'bg-on-surface/20',
                ]}
              />
            ))}
          </div>
          <button class="gallery-next w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:bg-surface-container-highest active:scale-90 transition-all">
            <span class="material-symbols-outlined text-lg">chevron_right</span>
          </button>
        </div>
      </div>
    )}
  </div>
)}

<style>
  .gallery-slider::-webkit-scrollbar { display: none; }
  .gallery-slider { scrollbar-width: none; -ms-overflow-style: none; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.gallery-slider').forEach(function (slider) {
      const wrapper = slider.parentElement!;
      const dots = wrapper.querySelectorAll('.gallery-dots button');
      const prevBtn = wrapper.querySelector('.gallery-prev');
      const nextBtn = wrapper.querySelector('.gallery-next');
      const gap = 12;

      function getChildWidth() {
        return (slider as HTMLElement).children[0]
          ? ((slider as HTMLElement).children[0] as HTMLElement).offsetWidth + gap
          : 1;
      }
      function getIndex() {
        return Math.round((slider as HTMLElement).scrollLeft / getChildWidth());
      }
      function scrollToIndex(i: number) {
        (slider as HTMLElement).scrollTo({
          left: i * getChildWidth(),
          behavior: 'smooth',
        });
      }
      function updateDots(index: number) {
        dots.forEach(function (dot, i) {
          (dot as HTMLElement).className =
            i === index
              ? 'w-3 h-3 rounded-full bg-primary transition-colors'
              : 'w-3 h-3 rounded-full bg-on-surface/20 transition-colors';
        });
      }

      slider.addEventListener('scroll', function () {
        updateDots(getIndex());
      });

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          scrollToIndex(i);
        });
      });

      if (prevBtn)
        prevBtn.addEventListener('click', function () {
          const i = getIndex();
          if (i > 0) scrollToIndex(i - 1);
        });
      if (nextBtn)
        nextBtn.addEventListener('click', function () {
          const i = getIndex();
          if (i < (slider as HTMLElement).children.length - 1) scrollToIndex(i + 1);
        });
    });
  });
</script>
