---
import BaseLayout from '../layouts/BaseLayout.astro';
import events from '../data/events.json';

// Schedule: 1 past + 2 future = 3 items. If not enough future, fill with past.
const allSorted = [...events].sort((a, b) => a.date.localeCompare(b.date));
const now = new Date().toISOString().slice(0, 10);
const futureEvents = allSorted.filter(e => e.date >= now);
const pastEvents = [...events].sort((a, b) => b.date.localeCompare(a.date)).filter(e => e.date < now);
const upcoming: typeof events = [];
// Add 1 most recent past event
if (pastEvents.length > 0) upcoming.push(pastEvents[0]);
// Add up to 2 future events
upcoming.push(...futureEvents.slice(0, 2));
// If still < 3, fill with more past events
let pastIdx = upcoming.includes(pastEvents[0]) ? 1 : 0;
while (upcoming.length < 3 && pastIdx < pastEvents.length) {
  if (!upcoming.includes(pastEvents[pastIdx])) upcoming.push(pastEvents[pastIdx]);
  pastIdx++;
}
// Sort by date ascending for display
upcoming.sort((a, b) => a.date.localeCompare(b.date));

// Latest activities: events with slug/content, sorted by date desc, top 5
const withContent = events
  .filter((e): e is typeof e & { slug: string; content: object; imageDir: string; heroImage: string } => !!e.slug && !!e.content)
  .sort((a, b) => b.date.localeCompare(a.date));
const latestActivities = withContent.slice(0, 5);

// Slideshow photos from events with imageDir
const slideshowPhotos: string[] = [];
for (const ev of events) {
  if (ev.imageDir && ev.heroImage) {
    slideshowPhotos.push(`/images/activities/${ev.imageDir}/${ev.heroImage}`);
  }
  if (ev.imageDir && ev.gridPhotos) {
    for (const p of ev.gridPhotos) {
      slideshowPhotos.push(`/images/activities/${ev.imageDir}/${p}`);
    }
  }
  if (ev.imageDir && ev.sliderPhotos) {
    for (const p of ev.sliderPhotos.slice(0, 2)) {
      slideshowPhotos.push(`/images/activities/${ev.imageDir}/${p}`);
    }
  }
}

function formatDateShort(dateStr: string) {
  const d = new Date(dateStr);
  return { month: `${d.getMonth() + 1}月`, day: d.getDate() };
}

function formatDateDot(dateStr: string) {
  return dateStr.replace(/-/g, '.');
}

const categoryColorMap: Record<string, { bg: string; text: string }> = {
  '例会': { bg: 'bg-secondary/10', text: 'text-secondary' },
  'イベント': { bg: 'bg-tertiary/10', text: 'text-tertiary' },
  '式典': { bg: 'bg-primary/10', text: 'text-primary' },
};

const categoryBadgeMap: Record<string, string> = {
  '例会': 'bg-secondary text-on-secondary',
  'イベント': 'bg-tertiary text-on-tertiary',
  '式典': 'bg-primary text-on-primary',
};
---
<BaseLayout title="ホーム" activePage="home">
<main class="pt-16 pb-32 max-w-2xl mx-auto">
<!-- Hero Section -->
<section class="relative h-[420px] flex items-end p-8 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img id="hero-img" alt="活動の様子" class="w-full h-full object-cover brightness-75" src={slideshowPhotos[0] || '/images/activities/2025-12-16_christmas/christmas01.jpg'} />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
  </div>
  <div class="relative z-10 w-full">
    <h2 class="font-headline text-5xl font-extrabold text-white leading-tight mb-4 tracking-tighter italic">We Serve</h2>
    <p class="text-white/90 text-lg font-medium max-w-xs leading-relaxed">福岡の街を、もっと輝かせたい。<br/>私たちは奉仕の力で繋がっています。</p>
  </div>
</section>

<!-- Upcoming Schedule -->
<section class="mt-10 px-6">
  <div class="bg-surface-container-low rounded-xl p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-headline font-bold text-lg flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">calendar_month</span>
        スケジュール
      </h3>
      <a class="text-xs text-secondary font-bold flex items-center gap-1" href="/schedule/">カレンダーを見る <span class="material-symbols-outlined" style="font-size:14px;">arrow_forward</span></a>
    </div>
    <div class="space-y-3" id="upcoming-events">
      {upcoming.map((ev) => {
        const { month, day } = formatDateShort(ev.date);
        const colors = categoryColorMap[ev.category] || { bg: 'bg-secondary/10', text: 'text-secondary' };
        const href = ev.slug ? `/events/${ev.slug}/` : '/schedule/';
        return (
          <a href={href} class="flex gap-4 items-center hover:bg-surface-container-lowest rounded-lg px-2 py-2 -mx-2 transition-colors">
            <div class:list={['w-12 h-12 rounded-lg flex flex-col items-center justify-center flex-shrink-0', colors.bg]}>
              <span class:list={['text-[10px] font-bold leading-none', colors.text]}>{month}</span>
              <span class:list={['text-lg font-bold leading-none', colors.text]}>{day}</span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-bold text-on-surface leading-snug">{ev.title}</p>
              <span class="text-[10px] text-on-surface-variant">{ev.category}</span>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant/40" style="font-size:18px;">chevron_right</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- Latest Activities -->
<section class="mt-10 px-6">
  <div class="flex items-center justify-between mb-6">
    <h3 class="font-headline font-bold text-xl flex items-center gap-2">最新の活動</h3>
    <a class="text-xs text-secondary font-bold flex items-center gap-1" href="/activities/">すべて見る <span class="material-symbols-outlined" style="font-size:14px;">arrow_forward</span></a>
  </div>
  <div class="space-y-6">
    {latestActivities[0] && (
      <a href={`/events/${latestActivities[0].slug}/`} class="scroll-reveal block bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm transition-all duration-500 active:scale-[0.98]">
        <div class="relative h-48 overflow-hidden">
          <img alt={latestActivities[0].title} class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" src={`/images/activities/${latestActivities[0].imageDir}/${latestActivities[0].heroImage}`} />
          <div class:list={['absolute top-4 left-4 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider', categoryBadgeMap[latestActivities[0].category] || 'bg-secondary text-on-secondary']}>
            {latestActivities[0].category}
          </div>
        </div>
        <div class="p-5">
          <span class="text-xs font-bold text-secondary font-label">{formatDateDot(latestActivities[0].date)}</span>
          <h4 class="font-bold text-lg mt-1 mb-2 leading-tight text-on-surface">{latestActivities[0].title}</h4>
          <p class="text-sm text-on-surface/70 line-clamp-2">{latestActivities[0].desc}</p>
        </div>
      </a>
    )}
    {latestActivities.length > 1 && (
      <div class="grid grid-cols-2 gap-4">
        {latestActivities.slice(1, 3).map((ev, i) => (
          <a href={`/events/${ev.slug}/`} class="scroll-reveal block bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm flex flex-col transition-all duration-500 active:scale-[0.98]" style={`transition-delay: ${i * 150}ms;`}>
            <div class="overflow-hidden">
              <img alt={ev.title} class="h-32 w-full object-cover transition-transform duration-700 hover:scale-105" src={`/images/activities/${ev.imageDir}/${ev.heroImage}`} />
            </div>
            <div class="p-3">
              <span class="text-[10px] font-bold text-on-surface/50">{formatDateDot(ev.date)}</span>
              <h4 class="font-bold text-sm mt-1 line-clamp-2">{ev.title}</h4>
            </div>
          </a>
        ))}
      </div>
    )}
    {latestActivities.length > 3 && (
      <div class="grid grid-cols-2 gap-4">
        {latestActivities.slice(3, 5).map((ev, i) => (
          <a href={`/events/${ev.slug}/`} class="scroll-reveal block bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm flex flex-col transition-all duration-500 active:scale-[0.98]" style={`transition-delay: ${i * 150}ms;`}>
            <div class="overflow-hidden">
              <img alt={ev.title} class="h-32 w-full object-cover transition-transform duration-700 hover:scale-105" src={`/images/activities/${ev.imageDir}/${ev.heroImage}`} />
            </div>
            <div class="p-3">
              <span class="text-[10px] font-bold text-on-surface/50">{formatDateDot(ev.date)}</span>
              <h4 class="font-bold text-sm mt-1 line-clamp-2">{ev.title}</h4>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<!-- Membership Banner -->
<section class="mt-12 px-6">
  <div class="bg-secondary rounded-xl p-8 text-center relative overflow-hidden">
    <div class="absolute top-0 right-0 w-24 h-24 bg-white/10 rounded-full -mr-12 -mt-12"></div>
    <h3 class="text-white font-bold text-xl mb-2">共に奉仕をしませんか？</h3>
    <p class="text-white/80 text-sm mb-6">福岡中央ライオンズクラブでは、随時新入会員を募集しています。</p>
    <a href="/about/" class="inline-block bg-white text-secondary font-bold px-8 py-3 rounded-full shadow-lg transition-transform active:scale-95">
      詳しい案内を見る
    </a>
  </div>
</section>
</main>

<script define:vars={{ slideshowPhotos }}>
(function() {
  var photos = slideshowPhotos;
  if (!photos.length) return;

  var img = document.getElementById('hero-img');
  var index = Math.floor(Math.random() * photos.length);
  img.src = photos[index];
  img.style.transition = 'opacity 1s ease-in-out';

  var preload = new Image();
  function next() {
    index = (index + 1) % photos.length;
    preload.src = photos[index];
    preload.onload = function() {
      img.style.opacity = '0';
      setTimeout(function() {
        img.src = photos[index];
        img.style.opacity = '1';
        preload = new Image();
        preload.src = photos[(index + 1) % photos.length];
      }, 1000);
    };
  }

  setInterval(next, 3000);
})();
</script>

<style>
  .scroll-reveal {
    opacity: 0;
    transform: translateY(24px);
  }
  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
</script>
</BaseLayout>
