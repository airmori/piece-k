---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>会員専用 | 福岡中央ライオンズクラブ</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-background min-h-screen flex items-center justify-center px-6" style="font-family: 'Noto Sans JP', sans-serif;">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-2 mb-4">
        <img src="/images/logo2.png" alt="Lions Club" class="h-10 w-10 object-contain" />
        <span class="font-bold text-sm text-on-surface">福岡中央ライオンズクラブ</span>
      </div>
      <h1 class="text-xl font-bold text-on-surface mb-1">会員専用ページ</h1>
      <p class="text-sm text-on-surface/60">パスワードを入力してお進みください</p>
    </div>
    <div id="error-msg" class="hidden">
      <p class="text-primary text-sm mb-4 text-center">パスワードが正しくありません。</p>
    </div>
    <form id="login-form" class="space-y-4">
      <input
        type="password"
        id="password-input"
        placeholder="パスワード"
        required
        autofocus
        class="w-full px-5 py-3 rounded-xl bg-white border border-outline-variant/30 text-sm focus:outline-none focus:ring-2 focus:ring-secondary/30 focus:border-secondary"
      />
      <button
        type="submit"
        class="w-full py-3 bg-secondary text-on-secondary font-bold text-sm rounded-full shadow-md hover:opacity-90 active:scale-95 transition-all"
      >
        ログイン
      </button>
    </form>
    <div class="text-center mt-6">
      <a href="/" class="text-xs text-on-surface/50 hover:text-primary transition-colors">← トップページに戻る</a>
    </div>
  </div>
  <script>
    document.getElementById('login-form')!.addEventListener('submit', function(e) {
      e.preventDefault();
      const pw = (document.getElementById('password-input') as HTMLInputElement).value;
      fetch('/api/members/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw })
      }).then(function(res) {
        if (res.ok) {
          window.location.href = '/members/dashboard/';
        } else {
          document.getElementById('error-msg')!.classList.remove('hidden');
        }
      });
    });
  </script>
</body>
</html>
