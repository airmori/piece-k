---
import BaseLayout from '../../layouts/BaseLayout.astro';
import events from '../../data/events.json';

// Build calendar events data for client-side JS
const calendarEvents = events.map(ev => ({
  date: ev.date,
  title: ev.title,
  link: ev.slug ? `/events/${ev.slug}/` : undefined,
  category: ev.category,
  image: ev.imageDir && ev.heroImage ? `/images/activities/${ev.imageDir}/${ev.heroImage}` : undefined,
  desc: ev.desc,
}));
---
<BaseLayout title="スケジュール" activePage="schedule">
<main class="pt-20 pb-32 px-4 max-w-2xl mx-auto w-full">

  <!-- Page Header -->
  <section class="mb-8 mt-4">
    <span class="text-primary font-bold tracking-widest text-xs uppercase mb-2 block">Schedule</span>
    <h2 class="font-headline text-3xl font-extrabold tracking-tight text-on-surface mb-2">スケジュール</h2>
    <p class="text-on-surface-variant text-sm leading-relaxed">活動予定と実績をカレンダーでご確認いただけます。</p>
  </section>

  <!-- Calendar Card -->
  <div class="bg-surface-container-lowest rounded-[1.5rem] shadow-[0_8px_32px_rgba(27,28,28,0.04)] overflow-hidden mb-4">

    <!-- Month Navigation -->
    <div class="flex items-center justify-between px-6 py-4">
      <button id="prev-month" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors active:scale-95">
        <span class="material-symbols-outlined text-on-surface-variant" style="font-size:20px;">chevron_left</span>
      </button>
      <div class="flex items-center gap-2">
        <span id="month-label" class="font-['Noto_Sans_JP'] font-bold text-base text-on-surface tracking-wide"></span>
        <button id="today-btn" class="hidden px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold hover:bg-primary/20 active:scale-95 transition-all">今日</button>
      </div>
      <button id="next-month" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors active:scale-95">
        <span class="material-symbols-outlined text-on-surface-variant" style="font-size:20px;">chevron_right</span>
      </button>
    </div>

    <!-- Day Headers -->
    <div class="grid grid-cols-7 px-2">
      <div class="text-center text-[11px] font-bold text-on-surface-variant py-1">月</div>
      <div class="text-center text-[11px] font-bold text-on-surface-variant py-1">火</div>
      <div class="text-center text-[11px] font-bold text-on-surface-variant py-1">水</div>
      <div class="text-center text-[11px] font-bold text-on-surface-variant py-1">木</div>
      <div class="text-center text-[11px] font-bold text-on-surface-variant py-1">金</div>
      <div class="text-center text-[11px] font-bold text-[#1d5fa8] py-1">土</div>
      <div class="text-center text-[11px] font-bold text-[#af000d] py-1">日</div>
    </div>

    <!-- Days Grid -->
    <div id="calendar-grid" class="grid grid-cols-7 px-1 pb-3"></div>

  </div>

</main>

<script define:vars={{ calendarEvents }}>
(function () {
  var categoryColors = {
    '例会':    { tag: 'bg-secondary',        badge: 'bg-secondary/10 text-secondary' },
    'イベント': { tag: 'bg-tertiary',          badge: 'bg-tertiary/10 text-tertiary' },
    '式典': { tag: 'bg-primary',           badge: 'bg-primary/10 text-primary' }
  };
  var defaultColor = { tag: 'bg-on-surface/60', badge: 'bg-on-surface/10 text-on-surface' };

  var events = calendarEvents;

  var eventMap = {};
  events.forEach(function (ev) { eventMap[ev.date] = ev; });

  var today = new Date();
  var viewYear = today.getFullYear();
  var viewMonth = today.getMonth();

  function pad(n) { return n < 10 ? '0' + n : String(n); }
  function toDateStr(y, m, d) { return y + '-' + pad(m + 1) + '-' + pad(d); }
  function formatDateDisplay(ds) {
    var p = ds.split('-');
    return p[0] + '.' + pad(parseInt(p[1])) + '.' + pad(parseInt(p[2]));
  }
  function getColors(cat) { return categoryColors[cat] || defaultColor; }

  function closePopup() {
    var overlay = document.getElementById('popup-overlay');
    if (overlay) overlay.remove();
  }

  function showPopup(ev) {
    closePopup();
    var colors = getColors(ev.category);
    var overlay = document.createElement('div');
    overlay.id = 'popup-overlay';
    overlay.className = 'fixed inset-0 z-[100] flex items-center justify-center px-6';
    overlay.style.background = 'rgba(27,28,28,0.5)';
    overlay.style.backdropFilter = 'blur(4px)';

    var imageHtml = ev.image
      ? '<div class="w-full aspect-[16/10] rounded-xl overflow-hidden mb-4 bg-surface-container">'
        + '<img src="' + ev.image + '" alt="' + ev.title + '" class="w-full h-full object-cover"/></div>'
      : '';

    var linkHtml = ev.link
      ? '<a href="' + ev.link + '" class="block w-full py-3 mt-4 bg-gradient-to-r from-secondary to-secondary-container text-white font-bold text-sm text-center rounded-full shadow-sm active:scale-95 transition-transform">詳しく見る</a>'
      : '';

    var card = document.createElement('div');
    card.className = 'bg-surface-container-lowest rounded-[1.5rem] shadow-lg max-w-sm w-full overflow-hidden';
    card.innerHTML = '<div class="p-5">'
      + '<div class="flex items-start justify-between mb-3">'
      + '<span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold tracking-wider ' + colors.badge + '">' + ev.category + '</span>'
      + '<button id="popup-close" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors -mr-1 -mt-1">'
      + '<span class="material-symbols-outlined text-on-surface-variant" style="font-size:20px;">close</span></button></div>'
      + imageHtml
      + '<div class="flex items-center gap-1.5 text-on-surface-variant/70 mb-1.5">'
      + '<span class="material-symbols-outlined" style="font-size:14px;">calendar_today</span>'
      + '<span class="text-xs font-medium">' + formatDateDisplay(ev.date) + '</span></div>'
      + '<h3 class="text-lg font-bold text-on-surface leading-snug mb-2">' + ev.title + '</h3>'
      + '<p class="text-sm text-on-surface-variant leading-relaxed">' + ev.desc + '</p>'
      + linkHtml
      + '</div>';

    overlay.appendChild(card);
    document.body.appendChild(overlay);

    overlay.addEventListener('click', function(e) { if (e.target === overlay) closePopup(); });
    document.getElementById('popup-close').addEventListener('click', closePopup);
  }

  function renderCalendar() {
    document.getElementById('month-label').textContent = viewYear + '年' + (viewMonth + 1) + '月';
    var grid = document.getElementById('calendar-grid');
    grid.innerHTML = '';

    var firstDay = new Date(viewYear, viewMonth, 1).getDay();
    var startOffset = (firstDay + 6) % 7;
    var daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

    for (var i = 0; i < startOffset; i++) {
      var empty = document.createElement('div');
      empty.className = 'min-h-[3.5rem] border-b border-surface-container';
      grid.appendChild(empty);
    }

    for (var d = 1; d <= daysInMonth; d++) {
      var dateStr = toDateStr(viewYear, viewMonth, d);
      var ev = eventMap[dateStr] || null;
      var colIndex = (startOffset + d - 1) % 7;
      var isSat = colIndex === 5;
      var isSun = colIndex === 6;
      var isToday = (viewYear === today.getFullYear() && viewMonth === today.getMonth() && d === today.getDate());

      var cell = document.createElement('div');
      cell.className = 'min-h-[3.5rem] border-b border-surface-container px-0.5 py-1 flex flex-col';

      var dayNum = document.createElement('span');
      var textColor = isSun ? 'text-[#af000d]' : isSat ? 'text-[#1d5fa8]' : 'text-on-surface/70';
      if (isToday) {
        dayNum.className = 'w-6 h-6 flex items-center justify-center rounded-full bg-primary text-white text-[11px] font-bold self-center';
      } else {
        dayNum.className = 'text-[11px] font-medium text-center ' + textColor;
      }
      dayNum.textContent = d;
      cell.appendChild(dayNum);

      if (ev) {
        var colors = getColors(ev.category);
        var tag = document.createElement('div');
        tag.className = colors.tag + ' text-white text-[8px] font-bold rounded px-1 py-0.5 mt-0.5 leading-tight truncate cursor-pointer hover:opacity-80 transition-opacity';
        tag.textContent = ev.title;
        tag.title = ev.title;
        (function(e) {
          tag.addEventListener('click', function() { showPopup(e); });
        })(ev);
        cell.appendChild(tag);
      }

      grid.appendChild(cell);
    }
  }

  function updateTodayBtn() {
    var btn = document.getElementById('today-btn');
    if (viewYear === today.getFullYear() && viewMonth === today.getMonth()) {
      btn.classList.add('hidden');
    } else {
      btn.classList.remove('hidden');
    }
  }

  document.getElementById('prev-month').addEventListener('click', function () {
    viewMonth--;
    if (viewMonth < 0) { viewMonth = 11; viewYear--; }
    closePopup();
    renderCalendar();
    updateTodayBtn();
  });

  document.getElementById('next-month').addEventListener('click', function () {
    viewMonth++;
    if (viewMonth > 11) { viewMonth = 0; viewYear++; }
    closePopup();
    renderCalendar();
    updateTodayBtn();
  });

  document.getElementById('today-btn').addEventListener('click', function () {
    viewYear = today.getFullYear();
    viewMonth = today.getMonth();
    closePopup();
    renderCalendar();
    updateTodayBtn();
  });

  renderCalendar();
  updateTodayBtn();
})();
</script>
</BaseLayout>
